---
import BaseLayout from "@components/base/BaseLayout.astro";
import BookCard from "@components/books/Card.astro";
import type { BooksEntry } from "@/types";
import EmotionalCompass, {
  type Story,
} from "@components/compass/EmotionalCompass";
import { arcs, fallbackArcKey, type ArcKey } from "@lib/arcs";

interface Props {
  entryIndex: BooksEntry;
  entries: BooksEntry[];
  storyRecommendations: Record<string, Story[]>;
}

const { entryIndex, entries, storyRecommendations }: Props = Astro.props;

const validKeys = new Set(arcs.map((a) => a.key));

// Group books into their arcs (in the order each arc defines), dropping
// hidden books. Anything with a missing/unknown arc falls into the fallback.
const visible = entries.filter((e) => !e.data.hidden);
const sections = arcs.map((arc) => ({
  arc,
  books: visible.filter((e) => {
    const key = (e.data.arc ?? fallbackArcKey) as ArcKey;
    return (validKeys.has(key) ? key : fallbackArcKey) === arc.key;
  }),
}));
---

<BaseLayout
  title={entryIndex.data.title}
  image={entryIndex.data.image?.src}
  description={entryIndex.data.description}
>
  <section class="flex justify-center">
    <div class="container text-center m-2">
      <div class="rounded-lg p-0 bg-gradient-to-t gradient">
        <div
          class="rounded-lg glass px-8 py-6 intersect:animate-fadeDown opacity-0 intersect-no-queue"
        >
          <h1 set:text={"The Elsebeneath Series"} />
          <p>
            A set of adventures in the <em>Elsebeneath</em>, a whimsical world
            of becoming.
          </p>

          <!-- Jump-to-arc navigation -->
          <nav
            class="mt-5 flex flex-wrap justify-center gap-2"
            aria-label="Story arcs"
          >
            {
              sections.map(({ arc }) => (
                <a
                  href={`#${arc.id}`}
                  class="rounded-full glass px-4 py-2 text-sm font-secondary font-semibold text-txt-p transition hover:bg-accent hover:text-white dark:text-darkmode-txt-p"
                >
                  {arc.title}
                </a>
              ))
            }
          </nav>
        </div>
      </div>
    </div>
  </section>

  <!-- One section per arc -->
  {
    sections.map(({ arc, books }) => (
      <section id={arc.id} class="section scroll-mt-24 m-2">
        <div class="container">
          <div class="text-center mb-8">
            <h2 class="text-3xl font-bold text-txt-p dark:text-darkmode-txt-p intersect:animate-fade opacity-0">
              {arc.title}
            </h2>
            <p class="mt-2 text-txt-s dark:text-darkmode-txt-s italic">
              {arc.tagline}
            </p>
          </div>

          <div class="flex flex-wrap justify-center">
            {books.map((entry) => (
              <div class="w-full sm:w-1/2 md:w-1/3 lg:w-1/4 p-2">
                <BookCard entry={entry} />
              </div>
            ))}

            {arc.placeholders?.map((p) => (
              <div class="w-full sm:w-1/2 md:w-1/3 lg:w-1/4 p-2">
                <div class="h-full m-2 bg-gradient-to-br gradient rounded-lg intersect:animate-fadeUp opacity-0">
                  <div class="glass h-full rounded-lg overflow-hidden shadow-md">
                    <div class="relative aspect-[2/3] flex flex-col items-center justify-center text-center p-6">
                      <span class="text-xs uppercase tracking-widest text-txt-s dark:text-darkmode-txt-s mb-3">
                        Coming soon
                      </span>
                      <h3 class="text-lg font-semibold text-txt-p dark:text-darkmode-txt-p">
                        {p.title}
                      </h3>
                      <p class="mt-2 text-sm text-txt-s dark:text-darkmode-txt-s">
                        {p.description}
                      </p>
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <!-- Emotional compass recommender -->
  <section class="section m-2">
    <div class="container">
      <EmotionalCompass storyData={storyRecommendations} client:load />
    </div>
  </section>
</BaseLayout>
